{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "membership-site",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* hits the Worker first; everything else is served as a free static asset.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "membership-db",
      // Replace after running: npx wrangler d1 create membership-db
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:8787",
    "EMAIL_FROM": "Members <login@example.com>"
  }
}
